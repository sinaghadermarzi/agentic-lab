# agentic-lab configuration — copy this file:  cp .env.example .env   (then edit .env)
# Every notebook's config cell reads .env, so settings here apply to the whole course.
# Same contract as the sibling course dspy-lab — one .env file can serve both repos.

# The one required key (the default models route through OpenRouter):
OPENROUTER_API_KEY=

# Global model choice (any LiteLLM provider string works).
# When a variable is unset, notebooks fall back to exactly these defaults.
MODEL=openrouter/deepseek/deepseek-v3.2
STRONG_MODEL=openrouter/deepseek/deepseek-v4-flash

# Alternatives, for reference:
# MODEL=openrouter/google/gemini-2.5-flash-lite
# MODEL=openai/gpt-4o-mini
# STRONG_MODEL=openrouter/moonshotai/kimi-k2.6
# STRONG_MODEL=openrouter/openai/gpt-4o

# Needed only if you point MODEL at a direct openai/... string:
# OPENAI_API_KEY=
